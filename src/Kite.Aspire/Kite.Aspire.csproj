<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>.NET Aspire hosting integration for Kite, an AWS cloud emulator for .NET. Adds the emulator, its resources and its dashboard to an Aspire AppHost.</Description>
    <PackageTags>$(PackageTags);aspire;hosting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="AppHost1\**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Kite.Tests.Unit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.3.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kite.Core\Kite.Core.csproj" />
    <ProjectReference Include="..\Kite.Host\Kite.Host.csproj" />
    <ProjectReference Include="..\Kite.Dashboard\Kite.Dashboard.csproj" />
  </ItemGroup>
</Project>
