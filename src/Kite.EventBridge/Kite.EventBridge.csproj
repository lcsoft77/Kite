<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Amazon EventBridge emulation, including EventBridge-to-Lambda triggers, for Kite, an AWS cloud emulator for .NET.</Description>
    <PackageTags>$(PackageTags);eventbridge;events</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Amazon.Lambda.CloudWatchEvents" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kite.Core\Kite.Core.csproj" />
    <ProjectReference Include="..\Kite.Lambda\Kite.Lambda.csproj" />
  </ItemGroup>
</Project>
