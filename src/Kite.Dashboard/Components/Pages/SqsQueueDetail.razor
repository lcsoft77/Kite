@page "/sqs/{QueueName}"
@implements IDisposable
@inject IServiceRegistry Registry
@inject IToastService Toast

<PageTitle>SQS: @QueueName</PageTitle>

@if (queue is null)
{
    <FluentLabel>Queue "@QueueName" not found.</FluentLabel>
    return;
}

<FluentLabel Typo="Typography.H3">📬 @queue.Name</FluentLabel>
<FluentLabel Style="color: var(--neutral-foreground-hint);">@queue.QueueUrl</FluentLabel>
<FluentDivider Style="margin: 12px 0;" />

<FluentGrid Spacing="3">
    <FluentGridItem xs="12" sm="4">
        <FluentCard Style="padding: 16px; text-align: center;">
            <FluentLabel Typo="Typography.H2" Style="color: var(--accent-fill-rest);">@queue.Messages.Count</FluentLabel>
            <FluentLabel>Queued Messages</FluentLabel>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="4">
        <FluentCard Style="padding: 16px; text-align: center;">
            <FluentLabel Typo="Typography.H2" Style="color: var(--accent-fill-rest);">@queue.VisibilityTimeouts.Count</FluentLabel>
            <FluentLabel>In-Flight</FluentLabel>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="4">
        <FluentCard Style="padding: 16px; text-align: center;">
            <FluentLabel Typo="Typography.H2" Style="color: var(--accent-fill-rest);">@sentCount</FluentLabel>
            <FluentLabel>Total Sent</FluentLabel>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

<div style="height: 16px;;"></div>

<FluentTabs>
    <FluentTab Label="📨 Send Message">
        <FluentCard Style="padding: 16px;">
            <FluentLabel Typo="Typography.H6">Send a Message</FluentLabel>
            <div style="height: 8px;;"></div>
            <FluentSelect TOption="string"
                          Label="Load payload from file"
                          Value="@selectedPayloadFile"
                          ValueChanged="@OnPayloadFileSelected"
                          Style="width: 100%; margin-bottom: 8px;">
                <FluentOption Value="">-- Select payload file --</FluentOption>
                @foreach (var file in payloadFiles)
                {
                    <FluentOption Value="@file">@Path.GetFileName(file)</FluentOption>
                }
            </FluentSelect>
            <FluentTextArea @bind-Value="messageBody"
                            Label="Message Body"
                            Rows="6"
                            Style="width: 100%; font-family: monospace;"
                            Placeholder="{}" />
            <div style="height: 8px;;"></div>
            <FluentStack>
                <FluentButton Appearance="Appearance.Accent" OnClick="SendMessage" IconStart="@(new Icons.Regular.Size16.Send())">
                    Send
                </FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="SavePayload" IconStart="@(new Icons.Regular.Size16.Save())">
                    Save as Payload File
                </FluentButton>
            </FluentStack>
        </FluentCard>
    </FluentTab>

    <FluentTab Label="⏱️ Real-time Messages">
        <FluentCard Style="padding: 16px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.H6" Style="flex: 1;">Recent Messages</FluentLabel>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearSentMessages" IconStart="@(new Icons.Regular.Size16.Delete())">
                    Clear
                </FluentButton>
            </FluentStack>
            <div style="height: 8px;;"></div>
            @if (!sentMessages.Any())
            {
                <FluentLabel Style="color: var(--neutral-foreground-hint);">No messages sent yet. Send a message or trigger from your application.</FluentLabel>
            }
            else
            {
                @foreach (var msg in sentMessages)
                {
                    <FluentCard Style="margin-bottom: 8px; padding: 10px; background: var(--neutral-fill-layer-rest);">
                        <FluentStack Orientation="Orientation.Horizontal">
                            <FluentLabel Style="font-size: 11px; color: var(--neutral-foreground-hint); min-width: 160px;">@msg.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</FluentLabel>
                            <FluentLabel Style="font-size: 11px; color: var(--neutral-foreground-hint); min-width: 180px;">ID: @msg.MessageId[..8]...</FluentLabel>
                        </FluentStack>
                        <pre style="margin: 4px 0 0 0; font-size: 12px; white-space: pre-wrap; word-break: break-all;">@FormatJson(msg.Body)</pre>
                    </FluentCard>
                }
            }
        </FluentCard>
    </FluentTab>

    <FluentTab Label="📋 Request Log">
        <FluentCard Style="padding: 16px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.H6" Style="flex: 1;">Request History</FluentLabel>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearLog" IconStart="@(new Icons.Regular.Size16.Delete())">
                    Clear
                </FluentButton>
            </FluentStack>
            <div style="height: 8px;;"></div>
            @if (!requestLog.Any())
            {
                <FluentLabel Style="color: var(--neutral-foreground-hint);">No requests yet.</FluentLabel>
            }
            else
            {
                <FluentDataGrid Items="@requestLog.AsQueryable()" Style="width: 100%;">
                    <PropertyColumn Property="@(e => e.Timestamp.ToLocalTime().ToString("HH:mm:ss"))" Title="Time" />
                    <PropertyColumn Property="@(e => e.Operation)" Title="Operation" />
                    <PropertyColumn Property="@(e => e.Details)" Title="Details" />
                    <TemplateColumn Title="Status">
                        <FluentBadge Appearance="@(context.StatusCode < 400 ? Appearance.Accent : Appearance.Lightweight)">
                            @context.StatusCode
                        </FluentBadge>
                    </TemplateColumn>
                </FluentDataGrid>
            }
        </FluentCard>
    </FluentTab>
</FluentTabs>

@code {
    [Parameter] public string QueueName { get; set; } = string.Empty;

    private SqsQueue? queue;
    private string messageBody = "{}";
    private List<string> payloadFiles = new();
    private string selectedPayloadFile = string.Empty;
    private List<SentMessageEntry> sentMessages = new();
    private List<RequestLogEntry> requestLog = new();
    private int sentCount = 0;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        queue = Registry.GetSqsQueue(Uri.UnescapeDataString(QueueName));
        if (queue is not null)
        {
            queue.OnChange += OnQueueChanged;
            RefreshData();
        }
        payloadFiles = PayloadHelper.GetPayloadFiles("sqs");
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    private void OnQueueChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshData();
            StateHasChanged();
        });
    }

    private void RefreshData()
    {
        if (queue is null) return;
        lock (queue.SentMessages)
            sentMessages = queue.SentMessages.AsEnumerable().Reverse().ToList();
        lock (queue.RequestLog)
            requestLog = queue.RequestLog.AsEnumerable().Reverse().ToList();
        sentCount = sentMessages.Count;
    }

    private async Task OnPayloadFileSelected(string? file)
    {
        selectedPayloadFile = file ?? string.Empty;
        if (!string.IsNullOrEmpty(file) && payloadFiles.Contains(file) && File.Exists(file))
            messageBody = await File.ReadAllTextAsync(file);
    }

    private void SendMessage()
    {
        if (queue is null) return;
        var msg = new SqsMessage
        {
            Body = messageBody,
            ReceiptHandle = Guid.NewGuid().ToString()
        };
        queue.Messages.Enqueue(msg);
        LogHelpers.AddSentMessage(queue.SentMessages, msg.MessageId.ToString(), msg.Body, "Dashboard");
        LogHelpers.AddRequestLog(queue.RequestLog, "SendMessage (Dashboard)", $"MessageId={msg.MessageId}");
        queue.NotifyChange();
        Toast.ShowSuccess($"Message sent to {queue.Name}");
    }

    private async Task SavePayload()
    {
        await PayloadHelper.SavePayloadAsync("sqs", messageBody);
        payloadFiles = PayloadHelper.GetPayloadFiles("sqs");
        Toast.ShowSuccess("Payload saved.");
    }

    private void ClearSentMessages()
    {
        if (queue is null) return;
        lock (queue.SentMessages) queue.SentMessages.Clear();
        RefreshData();
    }

    private void ClearLog()
    {
        if (queue is null) return;
        lock (queue.RequestLog) queue.RequestLog.Clear();
        RefreshData();
    }

    private static string FormatJson(string json)
    {
        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(doc, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch { return json; }
    }

    public void Dispose()
    {
        _timer?.Dispose();
        if (queue is not null) queue.OnChange -= OnQueueChanged;
    }
}
