@page "/ecs/{ClusterName}"
@implements IDisposable
@inject IServiceRegistry Registry

<PageTitle>ECS: @ClusterName</PageTitle>

@if (cluster is null)
{
    <FluentLabel>ECS cluster "@ClusterName" not found.</FluentLabel>
    return;
}

<FluentLabel Typo="Typography.H3">🐳 @cluster.Name</FluentLabel>
<FluentLabel Style="color: var(--neutral-foreground-hint);">Status: @cluster.Status</FluentLabel>
<FluentDivider Style="margin: 12px 0;" />

<FluentGrid Spacing="3">
    <FluentGridItem xs="12" sm="4">
        <FluentCard Style="padding: 16px; text-align: center;">
            <FluentLabel Typo="Typography.H2" Style="color: var(--accent-fill-rest);">@taskDefinitionsCount</FluentLabel>
            <FluentLabel>Task Definitions</FluentLabel>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="4">
        <FluentCard Style="padding: 16px; text-align: center;">
            <FluentLabel Typo="Typography.H2" Style="color: var(--accent-fill-rest);">@runningTasksCount</FluentLabel>
            <FluentLabel>Running Tasks</FluentLabel>
        </FluentCard>
    </FluentGridItem>
    <FluentGridItem xs="12" sm="4">
        <FluentCard Style="padding: 16px; text-align: center;">
            <FluentLabel Typo="Typography.H2" Style="color: var(--accent-fill-rest);">@stoppedTasksCount</FluentLabel>
            <FluentLabel>Stopped Tasks</FluentLabel>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

<div style="height: 16px;"></div>

<FluentTabs>
    <FluentTab Label="📋 Task Definitions">
        <FluentCard Style="padding: 16px;">
            <FluentLabel Typo="Typography.H6">Registered Task Definitions</FluentLabel>
            <div style="height: 8px;"></div>
            @if (!taskDefinitions.Any())
            {
                <FluentLabel Style="color: var(--neutral-foreground-hint);">No task definitions registered.</FluentLabel>
            }
            else
            {
                <FluentDataGrid Items="@taskDefinitions.AsQueryable()" Style="width: 100%;">
                    <PropertyColumn Property="@(d => d.Family)" Title="Family" />
                    <PropertyColumn Property="@(d => d.Revision)" Title="Revision" />
                    <PropertyColumn Property="@(d => d.Status)" Title="Status" />
                    <TemplateColumn Title="Containers">
                        <FluentLabel>@string.Join(", ", context.ContainerDefinitions.Select(c => c.Name))</FluentLabel>
                    </TemplateColumn>
                    <TemplateColumn Title="CPU / Memory">
                        <FluentLabel>@(context.Cpu?.ToString() ?? "-") / @(context.Memory?.ToString() ?? "-")</FluentLabel>
                    </TemplateColumn>
                </FluentDataGrid>
            }
        </FluentCard>
    </FluentTab>

    <FluentTab Label="🚀 Running Tasks">
        <FluentCard Style="padding: 16px;">
            <FluentLabel Typo="Typography.H6">Tasks</FluentLabel>
            <div style="height: 8px;"></div>
            @if (!clusterTasks.Any())
            {
                <FluentLabel Style="color: var(--neutral-foreground-hint);">No tasks in this cluster.</FluentLabel>
            }
            else
            {
                <FluentDataGrid Items="@clusterTasks.AsQueryable()" Style="width: 100%;">
                    <TemplateColumn Title="Task ID">
                        <FluentLabel Style="font-size: 12px; font-family: monospace;">@GetTaskId(context.TaskArn)</FluentLabel>
                    </TemplateColumn>
                    <TemplateColumn Title="Task Definition">
                        <FluentLabel Style="font-size: 12px;">@GetTaskDefinitionShortName(context.TaskDefinitionArn)</FluentLabel>
                    </TemplateColumn>
                    <TemplateColumn Title="Status">
                        <FluentBadge Appearance="@(context.LastStatus == "RUNNING" ? Appearance.Accent : Appearance.Lightweight)">
                            @context.LastStatus
                        </FluentBadge>
                    </TemplateColumn>
                    <PropertyColumn Property="@(t => t.CreatedAt.ToLocalTime().ToString("HH:mm:ss"))" Title="Started" />
                    <TemplateColumn Title="Stopped At">
                        <FluentLabel>@(context.StoppedAt.HasValue ? context.StoppedAt.Value.ToLocalTime().ToString("HH:mm:ss") : "-")</FluentLabel>
                    </TemplateColumn>
                </FluentDataGrid>
            }
        </FluentCard>
    </FluentTab>

    <FluentTab Label="📋 Request Log">
        <FluentCard Style="padding: 16px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.H6" Style="flex: 1;">Request History</FluentLabel>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="ClearLog" IconStart="@(new Icons.Regular.Size16.Delete())">
                    Clear
                </FluentButton>
            </FluentStack>
            <div style="height: 8px;"></div>
            @if (!requestLog.Any())
            {
                <FluentLabel Style="color: var(--neutral-foreground-hint);">No requests yet.</FluentLabel>
            }
            else
            {
                <FluentDataGrid Items="@requestLog.AsQueryable()" Style="width: 100%;">
                    <PropertyColumn Property="@(e => e.Timestamp.ToLocalTime().ToString("HH:mm:ss"))" Title="Time" />
                    <PropertyColumn Property="@(e => e.Operation)" Title="Operation" />
                    <PropertyColumn Property="@(e => e.Details)" Title="Details" />
                    <TemplateColumn Title="Status">
                        <FluentBadge Appearance="@(context.StatusCode < 400 ? Appearance.Accent : Appearance.Lightweight)">
                            @context.StatusCode
                        </FluentBadge>
                    </TemplateColumn>
                </FluentDataGrid>
            }
        </FluentCard>
    </FluentTab>
</FluentTabs>

@code {
    [Parameter] public string ClusterName { get; set; } = string.Empty;

    private EcsCluster? cluster;
    private List<EcsTaskDefinition> taskDefinitions = new();
    private List<EcsTask> clusterTasks = new();
    private List<RequestLogEntry> requestLog = new();
    private System.Threading.Timer? _timer;

    private int taskDefinitionsCount => taskDefinitions.Count;
    private int runningTasksCount => clusterTasks.Count(t => t.LastStatus == "RUNNING");
    private int stoppedTasksCount => clusterTasks.Count(t => t.LastStatus == "STOPPED");

    protected override void OnInitialized()
    {
        cluster = Registry.GetEcsCluster(Uri.UnescapeDataString(ClusterName));
        if (cluster is not null)
        {
            cluster.OnChange += OnClusterChanged;
            RefreshData();
        }
        _timer = new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    private void OnClusterChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshData();
            StateHasChanged();
        });
    }

    private void RefreshData()
    {
        if (cluster is null) return;
        taskDefinitions = Registry.GetAllEcsTaskDefinitions().OrderBy(d => d.Family).ThenBy(d => d.Revision).ToList();
        var clusterArn = $"arn:aws:ecs:{Registry.Region}:{Registry.AccountId}:cluster/{cluster.Name}";
        clusterTasks = Registry.GetEcsTasksForCluster(clusterArn).OrderByDescending(t => t.CreatedAt).ToList();
        lock (cluster.RequestLog)
            requestLog = cluster.RequestLog.AsEnumerable().Reverse().ToList();
    }

    private void ClearLog()
    {
        if (cluster is null) return;
        lock (cluster.RequestLog) cluster.RequestLog.Clear();
        RefreshData();
    }

    private static string GetTaskId(string taskArn)
    {
        var parts = taskArn.Split('/');
        return parts.Length > 0 ? parts[^1] : taskArn;
    }

    private static string GetTaskDefinitionShortName(string taskDefArn)
    {
        var parts = taskDefArn.Split('/');
        return parts.Length > 0 ? parts[^1] : taskDefArn;
    }

    public void Dispose()
    {
        _timer?.Dispose();
        if (cluster is not null) cluster.OnChange -= OnClusterChanged;
    }
}
