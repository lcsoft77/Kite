<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <Description>Blazor Server dashboard for inspecting queues, buckets, tables, topics and Lambda invocations in Kite, an AWS cloud emulator for .NET.</Description>
    <PackageTags>$(PackageTags);dashboard;blazor</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.0" />
    <!-- Supplies the Blazor framework JS files (blazor.web.js, blazor.server.js). The Web SDK
         auto-references this package but the Razor SDK (used by RCLs) does not, so the dashboard
         resolves them from the NuGet package cache at runtime (see DashboardExtensions).
         This deliberately flows to consumers: marking it PrivateAssets="all" would keep the
         package out of the consumer's restore graph and leave the dashboard without its scripts. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kite.Host\Kite.Host.csproj" />
    <ProjectReference Include="..\Kite.EventBridge\Kite.EventBridge.csproj" />
  </ItemGroup>
</Project>
